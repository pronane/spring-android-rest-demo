# Copy to .env.local for local runs, or set these in your host's dashboard.
#
# Required by `npm run build && npm start` (NODE_ENV=production): signing or
# verifying a session cookie throws without it. Generate one with:
#   openssl rand -hex 24
SESSION_SECRET=

# ——— Social sign-in (optional) ————————————————————————————————
#
# Each provider is independent: fill in all of a provider's variables and its
# button appears on /enter and /account; leave any of them blank and it is
# hidden. Nothing is enabled by default, so a fresh clone has no social login.
#
# Redirect URIs to register with each provider:
#   https://<your-host>/api/auth/google/callback
#   https://<your-host>/api/auth/apple/callback
#   https://<your-host>/api/auth/facebook/callback
#
# Google — console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Apple — developer.apple.com → Certificates, Identifiers & Profiles → Services ID
# APPLE_CLIENT_ID is the Services ID (e.g. ie.adarefantasy.web); the key is the
# .p8 you download once, pasted with its newlines as \n.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
#
# Facebook — developers.facebook.com → My Apps → Facebook Login → Settings
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
#
# Optional overrides — only for tests or a self-hosted proxy. Leave unset.
# GOOGLE_AUTHORIZE_URL= GOOGLE_TOKEN_URL= GOOGLE_JWKS_URL= GOOGLE_ISSUER= GOOGLE_SCOPE=
# APPLE_AUTHORIZE_URL=  APPLE_TOKEN_URL=  APPLE_JWKS_URL=  APPLE_ISSUER=  APPLE_SCOPE=
# FACEBOOK_AUTHORIZE_URL= FACEBOOK_TOKEN_URL= FACEBOOK_USERINFO_URL= FACEBOOK_DEBUG_TOKEN_URL=

# ——— Data and mail (optional) ————————————————————————————————
#
# Postgres. Unset, the app stores everything in .data/twenty-eight.json.
# The installer writes this for you when you ask for the bundled cluster:
#   npm run db:local -- start   → prints the URL
#   npm run db:migrate          → creates the tables in db/schema.sql
# DATABASE_URL=postgresql://user:pass@127.0.0.1:54329/twentyeight
#
# Where the bundled cluster lives and listens (defaults shown).
# PGPORT=54329
# PGDATA_DIR=.data/pg
#
# Emails (sign-in links) are written to this folder as JSON instead of being
# sent — useful locally, and how the end-to-end test reads its sign-in link.
# MAIL_OUTBOX=.data/outbox
#
# Real email instead:
# RESEND_API_KEY=
# MAIL_FROM=Twenty-Eight <hello@twenty-eight.golf>
