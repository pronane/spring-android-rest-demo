{
  "name": "adare-fantasy",
  "version": "0.1.0",
  "private": true,
  "description": "Fantasy league for the 2027 Ryder Cup at Adare Manor — first draft",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "data:refresh": "node scripts/refresh-data.mjs",
    "scoring:check": "tsx scripts/scoring-check.ts",
    "oauth:check": "DB_FILE=.data/oauth-check.json tsx scripts/oauth-check.ts",
    "payments:check": "tsx scripts/payments-check.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:local": "node scripts/local-db.mjs",
    "e2e": "node scripts/e2e.mjs",
    "start:local": "node scripts/start.mjs",
    "install:local": "node scripts/install.mjs",
    "seed": "tsx scripts/seed.ts",
    "snapshot": "node scripts/snapshot.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "db:check:sqlite": "tsx scripts/db-check-sqlite.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@libsql/client": "^0.18.0",
    "next": "^15.5.7",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.6",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "postcss": "^8.5.6",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
